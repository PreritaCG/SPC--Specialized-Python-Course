from textblob import TextBlob
from tkinter import *

text = input("Enter a sentence: ")
blob = TextBlob(text)

sentiment=blob.sentiment.polarity

print("Polarity:", blob.sentiment.polarity)
print("Subjectivity:", blob.sentiment.subjectivity)

if sentiment>0:
 print("positive")
elif sentiment < 0:
 print("negative")
else:
 print("neutral")
 